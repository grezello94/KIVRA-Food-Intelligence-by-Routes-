# Copy this file to .env and replace every value before starting the stack.
DATABASE_PROVIDER=Postgres
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
BOOTSTRAP_ADMIN_PIN=replace_with_a_secure_admin_pin
# Optional comma-separated /24 LANs when Docker cannot infer the host LAN.
PRINTER_DISCOVERY_NETWORKS=192.168.1.0/24
# PostgreSQL backups run automatically in Docker. Defaults: hourly, 7 days rolling, 60 daily snapshots.
POSTGRES_BACKUP_INTERVAL_SECONDS=3600
POSTGRES_BACKUP_KEEP_ROLLING=168
POSTGRES_BACKUP_KEEP_DAILY=60
